// Renovate config. Replaces Dependabot, matching the sister repo
// smur89/alta-typst, so both repos share one dependency bot and policy.
// Requires the Renovate GitHub App (https://github.com/apps/renovate) to be
// installed on the repository; without it this file does nothing.
// Keep this the only Renovate config file: a root `renovate.json` would be
// found first and shadow this one.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Keep actions pinned to full commit SHAs (with the `# vX.Y.Z` comment
    // Renovate maintains), and pin any new tag reference on its first PR.
    'helpers:pinGitHubActionDigests',
  ],

  // Only GitHub Actions. The library imports no `@preview/*` packages (the
  // only ones are in README.md examples, which the typst manager does not
  // scan, and they are either the self-import owned by release-please or
  // illustrative), so the typst manager would find nothing; if a .typ file
  // ever imports one, add 'typst' here plus a rule disabling the
  // `gairm-import` self-import.
  //
  // The regex manager below tracks build.yml's toolchain pins: typstyle
  // (which must match the typstyle used locally) and the package-check
  // image. TYPST_VERSION is deliberately not tracked: it is the minimum
  // Typst the package supports (`compiler` in typst.toml, the README), so
  // it is raised by hand, never on every Typst release.
  enabledManagers: ['github-actions', 'custom.regex'],

  customManagers: [
    {
      description: 'build.yml pins marked with a `# renovate:` comment.',
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/build\\.yml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)',
      ],
    },
    {
      description: 'The package-check image, by tag and digest.',
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/build\\.yml$/'],
      matchStrings: [
        'PCHECK_IMAGE: (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],

  // Dependabot ran Sunday 22:00. Renovate schedules are windows (hour
  // granularity, and the hosted app runs roughly hourly), so open Sunday
  // night and run into early Monday to avoid a skipped week.
  timezone: 'Europe/Zurich',
  schedule: ['* 22-23 * * 0', '* 0-4 * * 1'],

  prConcurrentLimit: 5,
  labels: ['dependencies'],

  // Conventional commits: `chore(deps): …` (release-please does not release
  // on chore; action bumps only touch CI, not the published package).
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',

  packageRules: [
    {
      description: 'typstyle: Renovate cannot compute the release asset hash, so the PR fails its checksum until TYPSTYLE_SHA256 is updated.',
      matchManagers: ['custom.regex'],
      matchPackageNames: ['typstyle-rs/typstyle'],
      minimumReleaseAge: '14 days',
      prBodyNotes: [
        'Before merging: set `TYPSTYLE_SHA256` in build.yml to the new asset\'s hash (`gh api repos/typstyle-rs/typstyle/releases/tags/{{{newValue}}} --jq \'.assets[] | select(.name=="typstyle-x86_64-unknown-linux-musl") | .digest\'`, without its `sha256:` prefix), update your local typstyle, and run `make fmt` if fmt-check fails.',
      ],
    },
    {
      description: 'The package-check image: give a new checker release time to settle.',
      matchManagers: ['custom.regex'],
      matchPackageNames: ['ghcr.io/typst/package-check'],
      minimumReleaseAge: '14 days',
    },
    {
      description: 'All GitHub Actions updates in one PR, as the Dependabot `actions` group did.',
      matchManagers: ['github-actions'],
      groupName: 'actions',
    },
  ],
}
